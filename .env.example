# Configuration de l'environnement pour Invoice Processor

# Clé API Google Gemini (OBLIGATOIRE)
# Obtenez-la ici : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Secret JWT (OBLIGATOIRE) — aucune valeur par défaut n'est codée en dur.
# Générez-en un fort : openssl rand -hex 32
JWT_SECRET_KEY=

# Origines CORS autorisées (séparées par des virgules). Vide = CORS désactivé.
# Exemple : https://app.exemple.com,http://localhost:3000
CORS_ORIGINS=

# Niveau de log de l'application (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# PostgreSQL — POSTGRES_PASSWORD est OBLIGATOIRE (aucun défaut en dur).
# En Docker Compose, POSTGRES_HOST est surchargé automatiquement (invoice-db).
POSTGRES_DB=invoice_db
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432