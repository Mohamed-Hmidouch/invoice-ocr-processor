# Configuration de l'environnement pour Invoice Processor

# Clé API Google Gemini (OBLIGATOIRE)
# Obtenez-la ici : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# PostgreSQL (Docker) — Valeurs par défaut dans docker-compose.yml
POSTGRES_DB=invoice_db
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=invoice_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432