# ── Secrets — NE JAMAIS inclure dans l'image ────────────────────────────────
.env
*.env
!.env.example

# ── Environnements virtuels / dependances locales ───────────────────────────
.venv/
venv/

# ── Caches Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Git / metadonnees ────────────────────────────────────────────────────────
.git/
.gitignore

# ── Donnees runtime (montees via volumes, pas dans l'image) ─────────────────
data/uploads/
data/output/
*.db

# ── Tests et scripts de dev ─────────────────────────────────────────────────
tests/
test_*.py
scripts/

# ── Docs / divers ────────────────────────────────────────────────────────────
docs/
README.md
*.log
=2.9.0
docker-compose.yml
Dockerfile
.dockerignore
